-- Функция очистки Item ESP
local function ClearItemESP()
    for _, v in pairs(ItemESPCache) do
        if v and v[1] and v[1]:IsA("BillboardGui") then
            v[1]:Destroy()
        end
    end
    ItemESPCache = {}
end

-- Функция создания ESP для предмета
local function CreateItemESP(model, name)
    local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not part then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Item"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 120, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = part
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(0, 170, 255)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.Code
    label.TextSize = 16
    label.Text = name
    label.Parent = billboard
    
    return {billboard}
end

-- Список папок для ESP предметов
local foldersToESP = {
    "Lootables",
    "BigLoot"
}

-- Функция Item ESP
local function ToggleItemESP(Value)
    ItemESPEnabled = Value
    
    ClearItemESP()
    
    if not Value then
        WindUI:Notify({
            Title = "Item ESP",
            Content = "Item ESP disabled"
        })
        return
    end
    
    pcall(function()
        for _, folderName in ipairs(foldersToESP) do
            local folder = Workspace:FindFirstChild(folderName)
            if folder then
                for _, model in pairs(folder:GetChildren()) do
                    if model:IsA("Model") then
                        local targetModel = model
                        local childrenModels = {}
                        
                        for _, child in pairs(model:GetChildren()) do
                            if child:IsA("Model") then
                                table.insert(childrenModels, child)
                            end
                        end
                        
                        if #childrenModels == 1 then
                            if childrenModels[1].Name ~= "Model" then
                                targetModel = childrenModels[1]
                            end
                        elseif #childrenModels > 1 then
                            for _, childModel in pairs(childrenModels) do
                                if childModel.Name ~= "Model" then
                                    targetModel = childModel
                                    break
                                end
                            end
                        end
                        
                        local esp = CreateItemESP(targetModel, targetModel.Name)
                        if esp then
                            table.insert(ItemESPCache, esp)
                        end
                    end
                end
            end
        end
    end)
    
    WindUI:Notify({
        Title = "Item ESP",
        Content = "Item ESP enabled"
    })
end

-- Основные функции

local function FindDrills()
    local drills = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name:lower():find("drill") and obj:IsA("Model") then
            table.insert(drills, obj)
        end
    end
    return drills
end

local function FindLoot()
    local loot = {}
    local lootNames = {"money", "cash", "bag", "loot", "jewel", "gold", "diamond", "artifact", "moneybags", "bagmoney", "robux", "goldbars"}
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local nameLower = obj.Name:lower()
            for _, lootName in ipairs(lootNames) do
                if nameLower:find(lootName) then
                    table.insert(loot, obj)
                    break
                end
            end
        end
    end
    return loot
end

local function FindGuards()
    local guards = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Player and player.Team and player.Team.Name:lower():find("guard") then
            table.insert(guards, player)
        end
    end
    return guards
end

local function FindNPCs()
    local npcs = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:find("CitizenHostage") or obj.Name:find("Citizen")) then
            table.insert(npcs, obj)
        end
    end
    return npcs
end

