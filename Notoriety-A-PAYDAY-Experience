-- Reset All
local function ResetAllNotoriety()
    -- Отключаем все функции
    AutoDrillEnabled = false
    AutoLootEnabled = false
    InfiniteAmmoEnabled = false
    GodModeEnabled = false
    NoAlarmEnabled = false
    SilentModeEnabled = false
    NoDetectionEnabled = false
    InstantKillEnabled = false
    FastStealEnabled = false
    ESPEnabled = false
    FlyEnabled = false
    NoclipEnabled = false
    SpeedBoostEnabled = false
    InfJumpEnabled = false
    AutoFarmEnabled = false
    FullBrightEnabled = false
    KillAllPoliceEnabled = false
    KillAllCitizensEnabled = false
    ItemESPEnabled = false
    
    -- Отключаем все соединения
    if DrillConnection then DrillConnection:Disconnect(); DrillConnection = nil end
    if LootConnection then LootConnection:Disconnect(); LootConnection = nil end
    if FlyConnection then FlyConnection:Disconnect(); FlyConnection = nil end
    if NoclipLoopConnection then NoclipLoopConnection:Disconnect(); NoclipLoopConnection = nil end
    if JumpConnection then JumpConnection:Disconnect(); JumpConnection = nil end
    if FarmConnection then FarmConnection:Disconnect(); FarmConnection = nil end
    if ESPConnection then ESPConnection:Disconnect(); ESPConnection = nil end
    if KillPoliceConnection then KillPoliceConnection:Disconnect(); KillPoliceConnection = nil end
    if KillCitizensConnection then KillCitizensConnection:Disconnect(); KillCitizensConnection = nil end
    
    -- Восстанавливаем стандартные настройки
    if Humanoid then
        Humanoid.WalkSpeed = WalkSpeed
        Humanoid.JumpPower = JumpPower
        Humanoid.MaxHealth = 100
        Humanoid.Health = 100
    end
    
    -- Очищаем ESP
    for _, highlight in pairs(ESPCache) do
        if highlight then
            pcall(function()
                highlight:Destroy()
                if highlight.Parent then
                    local billboard = highlight.Parent:FindFirstChild("NPC_NameTag")
                    if billboard then
                        billboard:Destroy()
                    end
                end
            end)
        end
    end
    ESPCache = {}
    
    -- Очищаем Item ESP
    ClearItemESP()
    
    -- Восстанавливаем освещение
    Lighting.Brightness = 2
    Lighting.Ambient = Color3.new(0.5, 0.5, 0.5)
    Lighting.GlobalShadows = true
    
    WindUI:Notify({
        Title = "Reset Complete",
        Content = "All features disabled"
    })
end

