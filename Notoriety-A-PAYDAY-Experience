-- ESP для игроков и NPC
local function ToggleESP()
    ESPEnabled = not ESPEnabled
    
    if ESPConnection then
        ESPConnection:Disconnect()
        ESPConnection = nil
    end
    
    for _, obj in pairs(ESPCache) do
        if obj then
            pcall(function() obj:Destroy() end)
        end
    end
    ESPCache = {}
    
    if ESPEnabled then
        ESPConnection = RunService.RenderStepped:Connect(function()
            pcall(function()
                -- ESP для игроков
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= Player and player.Character then
                        local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
                        if humanoidRootPart then
                            if not ESPCache[player] then
                                local highlight = Instance.new("Highlight")
                                highlight.Name = "ESP_Highlight"
                                highlight.FillColor = player.Team and player.Team.Name:lower():find("guard") and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                                highlight.FillTransparency = 0.7
                                highlight.OutlineTransparency = 0
                                highlight.Adornee = player.Character
                                highlight.Parent = player.Character
                                ESPCache[player] = highlight
                            end
                        end
                    end
                end
                
                -- ESP для NPC (CitizenHostage и Citizen)
                local npcs = FindNPCs()
                for _, npc in pairs(npcs) do
                    local humanoidRootPart = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head")
                    if humanoidRootPart then
                        if not ESPCache[npc] then
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "NPC_ESP_Highlight"
                            highlight.FillColor = Color3.fromRGB(0, 150, 255)
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.FillTransparency = 0.5
                            highlight.OutlineTransparency = 0
                            highlight.Adornee = npc
                            highlight.Parent = npc
                            ESPCache[npc] = highlight
                            
                            local billboard = Instance.new("BillboardGui")
                            billboard.Name = "NPC_NameTag"
                            billboard.Size = UDim2.new(0, 200, 0, 50)
                            billboard.StudsOffset = Vector3.new(0, 3, 0)
                            billboard.AlwaysOnTop = true
                            billboard.Adornee = humanoidRootPart
                            
                            local textLabel = Instance.new("TextLabel")
                            textLabel.Size = UDim2.new(1, 0, 1, 0)
                            textLabel.BackgroundTransparency = 1
                            textLabel.Text = npc.Name
                            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                            textLabel.TextScaled = true
                            textLabel.Font = Enum.Font.GothamBold
                            textLabel.Parent = billboard
                            
                            billboard.Parent = npc
                        end
                    end
                end
                
                for key, highlight in pairs(ESPCache) do
                    if not highlight or not highlight.Parent then
                        ESPCache[key] = nil
                    end
                end
            end)
        end)
        
        WindUI:Notify({
            Title = "ESP",
            Content = "ESP enabled (Players & NPCs)"
        })
    else
        for _, highlight in pairs(ESPCache) do
            if highlight then
                pcall(function()
                    highlight:Destroy()
                    if highlight.Parent then
                        local billboard = highlight.Parent:FindFirstChild("NPC_NameTag")
                        if billboard then
                            billboard:Destroy()
                        end
                    end
                end)
            end
        end
        ESPCache = {}
        
        WindUI:Notify({
            Title = "ESP",
            Content = "ESP disabled"
        })
    end
end

-- Fly
local function ToggleFly()
    FlyEnabled = not FlyEnabled
    
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end
    
    if HumanoidRootPart then
        for _, obj in pairs(HumanoidRootPart:GetChildren()) do
            if obj:IsA("BodyGyro") or obj:IsA("BodyVelocity") then
                obj:Destroy()
            end
        end
    end
    
    if FlyEnabled then
        if not Character or not HumanoidRootPart then return end
        
        local BodyGyro = Instance.new("BodyGyro")
        local BodyVelocity = Instance.new("BodyVelocity")
        
        BodyGyro.Parent = HumanoidRootPart
        BodyVelocity.Parent = HumanoidRootPart
        BodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        BodyGyro.CFrame = HumanoidRootPart.CFrame
        BodyGyro.P = 10000
        BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BodyVelocity.Velocity = Vector3.new(0, 0, 0)
        
        FlyConnection = RunService.Heartbeat:Connect(function()
            if not FlyEnabled or not Character or not HumanoidRootPart then
                if FlyConnection then
                    FlyConnection:Disconnect()
                end
                return
            end
            
            BodyVelocity.Velocity = Vector3.new(0, 0, 0)
            local cam = Workspace.CurrentCamera
            
            if cam then
                local camCFrame = cam.CFrame
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    BodyVelocity.Velocity = BodyVelocity.Velocity + (camCFrame.LookVector * FlySpeed)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    BodyVelocity.Velocity = BodyVelocity.Velocity - (camCFrame.LookVector * FlySpeed)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    BodyVelocity.Velocity = BodyVelocity.Velocity - (camCFrame.RightVector * FlySpeed)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    BodyVelocity.Velocity = BodyVelocity.Velocity + (camCFrame.RightVector * FlySpeed)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    BodyVelocity.Velocity = BodyVelocity.Velocity + Vector3.new(0, FlySpeed, 0)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                    BodyVelocity.Velocity = BodyVelocity.Velocity - Vector3.new(0, FlySpeed, 0)
                end
                
                BodyGyro.CFrame = camCFrame
            end
        end)
        
        WindUI:Notify({
            Title = "Flight",
            Content = "Flight enabled (WASD + Space/Shift)"
        })
    else
        WindUI:Notify({
            Title = "Flight",
            Content = "Flight disabled"
        })
    end
end

