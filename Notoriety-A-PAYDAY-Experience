-- Teleport to Vault
local function TeleportToVault()
    pcall(function()
        local vault = Workspace:FindFirstChild("Vault") or 
                     Workspace:FindFirstChild("BankVault") or 
                     Workspace:FindFirstChild("VaultDoor") or 
                     Workspace:FindFirstChild("Door") or 
                     Workspace:FindFirstChild("LockGate1") or 
                     Workspace:FindFirstChild("LockGate2") or
                     Workspace:FindFirstChild("MoneyVault")
        
        if vault and HumanoidRootPart then
            local position
            if vault:IsA("BasePart") then
                position = vault.Position
            elseif vault:IsA("Model") then
                local primaryPart = vault.PrimaryPart or vault:FindFirstChildWhichIsA("BasePart")
                position = primaryPart and primaryPart.Position or vault:GetPivot().Position
            else
                position = vault:GetPivot().Position
            end
            
            HumanoidRootPart.CFrame = CFrame.new(position + Vector3.new(0, 5, 0))
            WindUI:Notify({
                Title = "Vault Teleport",
                Content = "Teleported to vault"
            })
        else
            WindUI:Notify({
                Title = "Error",
                Content = "Vault not found"
            })
        end
    end)
end

