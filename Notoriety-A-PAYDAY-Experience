                    for _, guard in ipairs(policeFolder:GetChildren()) do
                        local humanoid = guard:FindFirstChildWhichIsA("Humanoid")
                        local head = guard:FindFirstChild("Head")
                        if humanoid and head and humanoid.Health > 0 then
