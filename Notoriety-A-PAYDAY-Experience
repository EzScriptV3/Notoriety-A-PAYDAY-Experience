                      Workspace:FindFirstChild("EscapeZone")
        
        if escape and HumanoidRootPart then
            local position
            if escape:IsA("BasePart") then
                position = escape.Position
            elseif escape:IsA("Model") then
                local primaryPart = escape.PrimaryPart or escape:FindFirstChildWhichIsA("BasePart")
                position = primaryPart and primaryPart.Position or escape:GetPivot().Position
            else
                position = escape:GetPivot().Position
            end
            
            HumanoidRootPart.CFrame = CFrame.new(position + Vector3.new(0, 5, 0))
            WindUI:Notify({
                Title = "Escape Teleport",
                Content = "Teleported to escape"
            })
        else
            WindUI:Notify({
                Title = "Error",
                Content = "Escape not found"
            })
        end
    end)
end

